{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@foldkit/oxlint-plugin/recommended.json"
  ],
  "plugins": [
    "typescript"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
