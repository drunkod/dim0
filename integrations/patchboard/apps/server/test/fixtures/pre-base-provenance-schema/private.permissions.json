{
  "$schema": "https://jazz.tools/schemas/jazz.permissions.v1.json",
  "tables": {
    "agentRuns": {
      "read": "false",
      "insert": "false",
      "update": "false",
      "delete": "false"
    },
    "appletStates": {
      "read": {
        "anyOf": [
          "exists boards(id = this.boardId, ownerId = session.user)",
          "exists boardMembers(boardId = this.boardId, userId = session.user)"
        ]
      },
      "insert": "false",
      "update": "false",
      "delete": "false"
    },
    "baseMemberships": {
      "read": {
        "allOf": [
          {
            "anyOf": [
              "exists boards(id = this.boardId, ownerId = session.user)",
              "exists boardMembers(boardId = this.boardId, userId = session.user)"
            ]
          },
          {
            "allOf": [
              "actorId = session.user",
              "state = 'active'"
            ]
          }
        ]
      },
      "insert": "false",
      "update": "false",
      "delete": "false"
    },
